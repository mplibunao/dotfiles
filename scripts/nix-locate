#!/usr/bin/env bash
#
# nix-locate
# ==========
# Locate the dotfiles Nix flake root (dotfiles/nix).
#
# Usage:
#   nix-locate [--nix-root|--dotfiles-root|--json]
#
# Precedence:
#   1) $DOTFILES_DIR/nix (if DOTFILES_DIR set and directory exists)
#   2) ~/Projects/personal/dotfiles/nix (default location)
#   3) Walk up from $PWD until a flake.nix is found (fallback)

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: nix-locate [options]

Options:
  --nix-root          Print dotfiles nix root path (default)
  --dotfiles-root     Print dotfiles root path
  --json              Print JSON with nix_root + dotfiles_root
  -h, --help          Show help
EOF
}

want="nix-root"
want_json="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --nix-root)
      want="nix-root"
      shift
      ;;
    --dotfiles-root)
      want="dotfiles-root"
      shift
      ;;
    --json)
      want_json="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

find_by_walking_up() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/flake.nix" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

nix_root=""
dotfiles_root=""

if [[ -n "${DOTFILES_DIR:-}" ]] && [[ -d "$DOTFILES_DIR/nix" ]]; then
  dotfiles_root="$DOTFILES_DIR"
  nix_root="$DOTFILES_DIR/nix"
elif [[ -d "$HOME/Projects/personal/dotfiles/nix" ]]; then
  dotfiles_root="$HOME/Projects/personal/dotfiles"
  nix_root="$HOME/Projects/personal/dotfiles/nix"
else
  if nix_root="$(find_by_walking_up)"; then
    dotfiles_root="$(dirname "$nix_root")"
  else
    echo "Error: could not locate a Nix flake root." >&2
    echo "Tried \$DOTFILES_DIR/nix, ~/Projects/personal/dotfiles/nix, and walking up from \$PWD." >&2
    exit 1
  fi
fi

if [[ "$want_json" == "true" ]]; then
  printf '{"nix_root":"%s","dotfiles_root":"%s"}\n' "$nix_root" "$dotfiles_root"
  exit 0
fi

case "$want" in
  nix-root) echo "$nix_root" ;;
  dotfiles-root) echo "$dotfiles_root" ;;
  *)
    echo "Error: internal: unknown output mode: $want" >&2
    exit 2
    ;;
esac
