#!/usr/bin/env bash
#
# claude-proxy-route
# ==================
# Turn Claude Code's global CLIProxyAPI route on or off for this Mac.
#
# The route setting is ~/.local/state/cli-proxy-api/claude-route, holding `on`
# or `off`; a missing file means on. This command is its only writer. The env
# LaunchAgent com.mp.cli-proxy-env reads it and publishes or clears
# ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN for the GUI session, and
# claude-launch reads it on every launch. on, off and apply re-run that agent
# with `launchctl kickstart`. launchd runs one instance of a job at a time, so
# two publications never overlap.
#
# This command never reads the secrets file and never prints a key. The
# agent's `launchctl print` output includes its inherited environment, which
# holds the token, so only single fields are extracted from it and the output
# itself is never shown.
#
# Keep it compatible with bash 3.2 (macOS /bin/bash): CI runs the tests with
# whatever bash is first on PATH. Runbook: nix/docs/runbooks/cli-proxy-api.md.

set +x
set -euo pipefail
umask 077

prog="claude-proxy-route"
label="com.mp.cli-proxy-env"
# The URL the env agent publishes, from mp.cliProxyApi.host and port in
# cli-proxy-api.nix.
proxy_url="http://127.0.0.1:8317"
launchctl_bin="/bin/launchctl"
poll_interval=0.2
poll_limit=75 # 15 seconds
poll_notice=5 # 1 second

usage() {
  cat <<'EOF'
Usage: claude-proxy-route on|off|apply|status

  on      Route Claude Code through CLIProxyAPI. This is the default.
  off     Send Claude Code straight to Anthropic. OpenCode keeps its key.
  apply   Publish again without changing the setting, for example after
          rotating the client key or to retry a failed publication.
  status  Show the saved setting and what launchd publishes now.

on, off and apply re-run com.mp.cli-proxy-env, then print status. Running
apps keep the environment they started with: after a change, quit and reopen
them and open new terminal windows.

--launchctl PATH replaces /bin/launchctl, for tests.
EOF
}

die() {
  printf '%s: %s\n' "$prog" "$1" >&2
  exit 1
}

usage_error() {
  printf '%s: %s\n' "$prog" "$1" >&2
  usage >&2
  exit 2
}

# Sets route to on or off, and route_default to 1 when the file is missing.
# On any other file it sets route_error and returns 1. cli-proxy-env-launch
# has a copy of this function; keep the two identical. cmp compares bytes, so
# extra lines, spaces, CRs and NULs are rejected rather than trimmed.
read_route_setting() {
  local file="$1" value dir
  route=""
  route_default=0
  route_error=""
  if [[ ! -e "$file" && ! -L "$file" ]]; then
    # Missing only when the nearest existing ancestor is a searchable
    # directory. Otherwise the lookup failed on a permission, and that must
    # not become the default.
    dir="$(dirname "$file")"
    while [[ ! -e "$dir" ]]; do
      dir="$(dirname "$dir")"
    done
    if [[ ! -d "$dir" || ! -x "$dir" ]]; then
      route_error="${file} cannot be looked up: ${dir} is not a searchable directory"
      return 1
    fi
    route="on"
    route_default=1
    return 0
  fi
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    route_error="${file} is not a readable file"
    return 1
  fi
  for value in on off; do
    if printf '%s' "$value" | cmp -s - "$file" \
      || printf '%s\n' "$value" | cmp -s - "$file"; then
      route="$value"
      return 0
    fi
  done
  route_error="${file} does not contain on or off"
  return 1
}

[[ "$EUID" -ne 0 ]] || die "refusing to run as root: HOME and the GUI session would not be yours. Run it as your login user."

op=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --launchctl)
      [[ $# -ge 2 ]] || usage_error "--launchctl needs a value."
      launchctl_bin="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    on | off | apply | status)
      [[ -z "$op" ]] || usage_error "give one operation."
      op="$1"
      shift
      ;;
    *)
      usage_error "unknown argument: $1"
      ;;
  esac
done
[[ -n "$op" ]] || usage_error "give one of on, off, apply or status."
[[ -n "${HOME:-}" ]] || die "HOME is not set."

# Fixed under HOME, ignoring XDG_STATE_HOME, to match the path Home Manager
# builds into the agent and the one claude-launch reads.
state_dir="${HOME}/.local/state/cli-proxy-api"
route_file="${state_dir}/claude-route"
err_log="${state_dir}/cli-proxy-env.err.log"
plist="${HOME}/Library/LaunchAgents/${label}.plist"
target="gui/${UID}/${label}"

saved_route=""
tmp_file=""
cleanup() {
  if [[ -n "$tmp_file" ]]; then
    rm -f "$tmp_file"
  fi
}
trap cleanup EXIT

# Writes a mode-0600 file next to the setting and renames it over the
# setting, so a reader sees the old contents or the new, never a partial
# write. Replaces malformed contents.
write_setting() {
  [[ ! -d "$route_file" ]] || die "${route_file} is a directory; remove it, then run this again."
  mkdir -p "$state_dir"
  tmp_file="$(mktemp "${route_file}.XXXXXX")"
  chmod 0600 "$tmp_file"
  printf '%s\n' "$1" >"$tmp_file"
  mv -f "$tmp_file" "$route_file"
  tmp_file=""
  saved_route="$1"
}

# Starts a failure message, so the reader knows whether the file changed.
failure_prefix() {
  if [[ -n "$saved_route" ]]; then
    printf 'saved the setting (%s), but ' "$saved_route"
  fi
}

agent_state=""
read_agent_state() {
  agent_state="$("$launchctl_bin" print "$target" 2>/dev/null)"
}

# Prints one top-level field of the agent's state. The pattern matches
# launch-agent.nix, without its early `exit`: awk reads all of its input, so
# printf never hits a closed pipe under pipefail.
agent_field() {
  printf '%s\n' "$agent_state" \
    | awk -F ' = ' -v key="$1" '$1 == "\t" key && !found { print $2; found = 1 }'
}

not_loaded() {
  printf '%s: %s%s is not loaded in gui/%s, or this is not the logged-in GUI session (for example over SSH).\n' \
    "$prog" "$(failure_prefix)" "$label" "$UID" >&2
  printf '  To load it, which also runs it once:\n    launchctl bootstrap gui/%s %s\n' "$UID" "$plist" >&2
  exit 1
}

# Re-runs the env agent and waits until launchd records the new run as
# finished. Exits 1 if it cannot be started, does not finish in time, or
# exits non-zero.
publish() {
  local runs_before runs_now exit_code polls=0
  read_agent_state || not_loaded
  runs_before="$(agent_field runs)"
  [[ "$runs_before" =~ ^[0-9]+$ ]] || runs_before=0
  "$launchctl_bin" kickstart "$target" >/dev/null 2>&1 || not_loaded
  while :; do
    if read_agent_state; then
      runs_now="$(agent_field runs)"
      if [[ "$runs_now" =~ ^[0-9]+$ ]] && ((runs_now > runs_before)) \
        && [[ -z "$(agent_field pid)" ]]; then
        break
      fi
    fi
    polls=$((polls + 1))
    if ((polls >= poll_limit)); then
      agent_state=""
      die "$(failure_prefix)${label} did not finish within 15 seconds. Check claude-proxy-route status, then run claude-proxy-route apply to retry."
    fi
    if ((polls == poll_notice)); then
      printf '%s: waiting for launchd to run %s...\n' "$prog" "$label" >&2
    fi
    sleep "$poll_interval"
  done
  exit_code="$(agent_field 'last exit code')"
  agent_state=""
  if [[ "$exit_code" != "0" ]]; then
    printf '%s: %s%s exited with code %s, so launchd may not match the setting.\n' \
      "$prog" "$(failure_prefix)" "$label" "${exit_code:-unknown}" >&2
    if [[ -s "$err_log" ]]; then
      printf '  Last lines of %s:\n' "$err_log" >&2
      tail -n 5 "$err_log" | sed 's/^/    /' >&2
    fi
    printf '  Fix the cause, then run: claude-proxy-route apply\n' >&2
    exit 1
  fi
}

# Sets lc_value to launchd's value for NAME, empty when unset. Returns
# non-zero when launchctl itself fails, as it does without a GUI session.
lc_getenv() {
  lc_value="$("$launchctl_bin" getenv "$1" 2>/dev/null)"
}

# Prints the saved setting and what launchd publishes. Values are compared,
# never printed. Returns 1 when the two disagree, launchd cannot be queried,
# the client key is missing, or the setting is malformed.
show_status() {
  local rc=0 setting_ok=1 setting published key_state url
  if read_route_setting "$route_file"; then
    setting="$route"
    if [[ $route_default -eq 1 ]]; then
      setting="on (default: ${route_file} does not exist)"
    fi
  else
    setting="error: ${route_error}"
    setting_ok=0
    rc=1
  fi

  published="unavailable"
  if lc_getenv ANTHROPIC_BASE_URL; then
    url="$lc_value"
    if lc_getenv ANTHROPIC_AUTH_TOKEN; then
      if [[ "$url" == "$proxy_url" && -n "$lc_value" ]]; then
        published="on"
      elif [[ -z "$url" && -z "$lc_value" ]]; then
        published="off"
      else
        published="mixed"
      fi
    fi
  fi
  key_state="unavailable"
  if lc_getenv CLIPROXY_CLIENT_KEY; then
    if [[ -n "$lc_value" ]]; then
      key_state="present"
    else
      key_state="missing"
    fi
  fi
  lc_value=""

  printf 'saved setting:        %s\n' "$setting"
  printf 'published route:      %s\n' "$published"
  printf 'published client key: %s\n' "$key_state"
  if [[ $setting_ok -eq 0 ]]; then
    printf 'Save a valid setting with: claude-proxy-route on (or off)\n'
  elif [[ "$published" == "unavailable" || "$key_state" == "unavailable" ]]; then
    printf 'launchctl could not be queried. Run this in the logged-in GUI session, not over SSH.\n'
    rc=1
  elif [[ "$published" != "$route" || "$key_state" != "present" ]]; then
    printf 'launchd does not match the setting. Check %s, fix the cause, then run: claude-proxy-route apply\n' "$err_log"
    rc=1
  fi
  printf 'Running apps keep the environment they started with. After a change, quit and reopen them and open new terminal windows.\n'
  return "$rc"
}

case "$op" in
  status)
    show_status
    ;;
  apply)
    read_route_setting "$route_file" \
      || die "${route_error}. Save a valid setting with: claude-proxy-route on (or off)."
    publish
    show_status
    ;;
  on | off)
    write_setting "$op"
    publish
    show_status
    ;;
esac
