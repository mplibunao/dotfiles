#!/usr/bin/env bash
#
# cli-proxy-runtime-config
# ========================
# Write the CLIProxyAPI config the LaunchAgent actually starts with.
#
# v8.0.53 reads client keys from access.api-keys. The legacy top-level
# api-keys list is the same field. Nothing in the process environment
# supplies a client key (MANAGEMENT_PASSWORD is only the management key).
# The Home Manager config.yaml is a world-readable store symlink, so this
# copies that template to a mode-0600 file outside the store and appends
# access.api-keys from CLIPROXY_CLIENT_KEY. When secrets.env also has an
# optional DEEPSEEK_API_KEY, it appends a DeepSeek openai-compatibility provider
# (v8 layout: api-keys.openai-compatibility) so OpenCode's DeepSeek traffic is
# recorded by the proxy. Without that line no DeepSeek entry is written.
#
# Do not run this script under `set -x`. A trace would show the key.

set +x
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: cli-proxy-runtime-config --secrets FILE --template FILE --out FILE

Reads CLIPROXY_CLIENT_KEY (and the optional DEEPSEEK_API_KEY) from FILE
(mode 0600) and writes a mode-0600 runtime config to OUT. Prints nothing on success. Refuses to write into
the Nix store, to replace a symlink, or to append when the template
already has an access: section.
EOF
}

die() {
  printf 'cli-proxy-runtime-config: %s\n' "$1" >&2
  exit 1
}

file_mode() {
  local mode
  if mode="$(stat -c '%a' "$1" 2>/dev/null)"; then
    printf '%s\n' "$mode"
  else
    stat -f '%Lp' "$1"
  fi
}

# Assigns the client key to the nameref in $1. Does not print it.
read_client_key() {
  local _dest="$1" _file="$2" _value
  [[ -f "$_file" ]] || die "missing ${_file}."
  local _mode
  _mode="$(file_mode "$_file")"
  [[ "$_mode" == "600" ]] || die "${_file} is mode ${_mode}; run chmod 0600 on it."
  _value="$(
    awk '
      function trim(s) {
        sub(/^[[:space:]]+/, "", s)
        sub(/[[:space:]]+$/, "", s)
        return s
      }
      /^[[:space:]]*($|#)/ { next }
      {
        eq = index($0, "=")
        if (eq == 0) next
        k = trim(substr($0, 1, eq - 1))
        sub(/^export[[:space:]]+/, "", k)
        if (k != "CLIPROXY_CLIENT_KEY") next
        v = trim(substr($0, eq + 1))
        if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2)
        if (v == "") {
          err = "empty"
          exit 2
        }
        if (v !~ /^[0-9a-f]{64}$/) {
          err = "format"
          exit 2
        }
        print v
        err = "ok"
        exit 0
      }
      END {
        if (err == "ok") exit 0
        if (err == "empty") {
          print "cli-proxy-runtime-config: CLIPROXY_CLIENT_KEY is empty." > "/dev/stderr"
          exit 2
        }
        if (err == "format") {
          print "cli-proxy-runtime-config: CLIPROXY_CLIENT_KEY must be 64 hex characters." > "/dev/stderr"
          exit 2
        }
        print "cli-proxy-runtime-config: CLIPROXY_CLIENT_KEY is missing from the secrets file." > "/dev/stderr"
        exit 2
      }
    ' "$_file"
  )" || die "could not read CLIPROXY_CLIENT_KEY."
  printf -v "$_dest" '%s' "$_value"
  unset _value
}

# Assigns the optional DeepSeek key (empty when absent) to the nameref in $1.
# The secrets file's mode was already checked by read_client_key.
read_deepseek_key() {
  local _dest="$1" _file="$2" _line _value=""
  local _re='^[[:space:]]*(export[[:space:]]+)?DEEPSEEK_API_KEY[[:space:]]*=(.*)$'
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    if [[ "$_line" =~ $_re ]]; then
      _value="${BASH_REMATCH[2]}"
      _value="${_value#"${_value%%[![:space:]]*}"}"
      _value="${_value%"${_value##*[![:space:]]}"}"
      if [[ "$_value" == \"*\" ]]; then _value="${_value:1:${#_value}-2}"; fi
    fi
  done <"$_file"
  if [[ -n "$_value" && ! "$_value" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "DEEPSEEK_API_KEY has unexpected characters."
  fi
  printf -v "$_dest" '%s' "$_value"
  unset _value _line
}

secrets=""
template=""
out=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --secrets)
      [[ $# -ge 2 ]] || die "--secrets needs a value."
      secrets="$2"
      shift 2
      ;;
    --template)
      [[ $# -ge 2 ]] || die "--template needs a value."
      template="$2"
      shift 2
      ;;
    --out)
      [[ $# -ge 2 ]] || die "--out needs a value."
      out="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$secrets" && -n "$template" && -n "$out" ]] || die "need --secrets, --template, and --out."
[[ -f "$template" ]] || die "missing template ${template}."
case "$out" in
  /nix/store/*)
    die "refusing to write ${out} inside the Nix store."
    ;;
esac
if [[ "$out" == "$template" ]]; then
  die "refusing to overwrite the template."
fi
if [[ -L "$out" ]]; then
  die "refusing to replace symlink ${out}."
fi
if grep -q '^access:' "$template"; then
  die "template already has an access: section."
fi

key=""
deepseek_key=""
tmp=""
cleanup() {
  unset key deepseek_key
  if [[ -n "${tmp:-}" && -f "$tmp" ]]; then
    rm -f "$tmp"
  fi
}
trap cleanup EXIT

read_client_key key "$secrets"
read_deepseek_key deepseek_key "$secrets"
if [[ -n "$deepseek_key" ]] && grep -q '^api-keys:' "$template"; then
  die "template already has an api-keys: section."
fi

out_dir="$(dirname "$out")"
mkdir -p "$out_dir"
chmod 0700 "$out_dir"
umask 077
tmp="$(mktemp "${out_dir}/runtime-config.yaml.XXXXXX")"
chmod 0600 "$tmp"
cat "$template" >"$tmp"
printf '\naccess:\n  api-keys:\n    - "%s"\n' "$key" >>"$tmp"
unset key
if [[ -n "$deepseek_key" ]]; then
  printf '\napi-keys:\n  openai-compatibility:\n    - name: "deepseek"\n      base-url: "https://api.deepseek.com/v1"\n      keys:\n        - api-key: "%s"\n      models:\n        - name: "deepseek-v4-pro"\n          alias: "deepseek-v4-pro"\n        - name: "deepseek-flash"\n          alias: "deepseek-flash"\n' "$deepseek_key" >>"$tmp"
fi
unset deepseek_key
mv "$tmp" "$out"
tmp=""
chmod 0600 "$out"
mode="$(file_mode "$out")"
if [[ "$mode" != "600" ]]; then
  rm -f "$out"
  die "runtime config mode is ${mode}, expected 0600."
fi
